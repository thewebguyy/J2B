# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/

# Production build artifacts & caches
build
dist
.vercel
*.tsbuildinfo
next-env.d.ts

# Debug & runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files
.env*.local
.env
.env.development.local
.env.test.local
.env.production.local

# Operating System files
.DS_Store
Thumbs.db

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo

# Temporary scratch & test artifacts
/scratch/

# Video source footage and encoding intermediates (keep outside public/ and
# prefer object storage or Git LFS for long-term ownership)
/*.mp4
/*.mov
/*.webm

# Local browser QA artifacts
/public/qa-screens/

# Python tooling caches for the media scripts
__pycache__/
*.pyc
