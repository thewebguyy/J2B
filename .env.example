# Enquiry form — public feature flag
# Set to "true" to enable the enquiry form in the UI. Rebuild after changing.
NEXT_PUBLIC_ENQUIRY_ENABLED=false

# Email delivery via Resend (server-side only; never expose these to the client)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=hello@journey2better.com
ENQUIRY_FROM_EMAIL=Journey2Better <onboarding@resend.dev>

# Optional: comma-separated origins allowed to POST to /api/enquiries.
# Entries may use a single "*" wildcard, e.g. https://*.vercel.app
# Leave empty to use the built-in defaults (production URL, localhost, previews).
ALLOWED_ORIGINS=
